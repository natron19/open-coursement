<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">My Courses</h1>
  <%= link_to "New Outline", new_course_brief_path, class: "btn btn-primary" %>
</div>

<% if @briefs.empty? %>
  <div class="text-center py-5">
    <p class="text-muted mb-3">You haven't generated any outlines yet.</p>
    <%= link_to "Generate your first outline", new_course_brief_path, class: "btn btn-primary" %>
  </div>
<% else %>
  <div class="row g-4">
    <% @briefs.each do |brief| %>
      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title"><%= brief.topic %></h5>
            <div class="d-flex align-items-center gap-2 mb-2">
              <% badge_class = case brief.skill_level
                               when "beginner"     then "bg-secondary"
                               when "intermediate" then "bg-info text-dark"
                               when "advanced"     then "badge-draft"
                               end %>
              <span class="badge <%= badge_class %>"><%= brief.skill_level.capitalize %></span>
              <% if brief.has_draft? %>
                <span class="badge badge-draft">Draft</span>
              <% end %>
            </div>
            <p class="card-text text-muted small">
              <%= brief.course_outlines.size %> outline<%= "s" if brief.course_outlines.size != 1 %>
              &middot; <%= brief.created_at.strftime("%b %-d, %Y") %>
            </p>
          </div>
          <div class="card-footer d-flex gap-2">
            <%= link_to "View Outlines", course_brief_path(brief), class: "btn btn-sm btn-outline-primary" %>
            <%= button_to "Delete", course_brief_path(brief),
                method: :delete,
                data: { turbo_confirm: "Delete this brief and all outlines?" },
                class: "btn btn-sm btn-outline-danger" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
